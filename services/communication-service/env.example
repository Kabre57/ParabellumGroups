# Copy to .env for local runs outside Docker Compose.
NODE_ENV=development
PORT=4002
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_communication?schema=public
JWT_SECRET=replace-with-a-long-random-secret
AUTO_DB_PUSH=false
CAMPAIGN_SCHEDULER_INTERVAL_MS=60000

# Stockage privé MinIO/S3 des pièces jointes de messagerie
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=communication-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=replace-with-minio-password
S3_FORCE_PATH_STYLE=true

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@parabellum.local
