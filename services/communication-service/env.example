# Copy to .env for local runs outside Docker Compose.
NODE_ENV=development
PORT=4002
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_communication?schema=public
JWT_SECRET=replace-with-a-long-random-secret
AUTO_DB_PUSH=false
CAMPAIGN_SCHEDULER_INTERVAL_MS=60000

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@parabellum.local
