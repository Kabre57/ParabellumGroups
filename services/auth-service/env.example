# Copy to .env for local runs outside Docker Compose.
NODE_ENV=development
PORT=4001
CORS_ORIGIN=http://localhost:3000

# Host ports published by the root docker-compose.yml
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_auth?schema=public
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=parabellum_auth
REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:16379

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_EMAIL=admin@parabellum.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

EMAIL_PROVIDER=local
EMAIL_FROM=noreply@parabellum.local
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
GMAIL_USER=
GMAIL_PASSWORD=
ADMIN_DASHBOARD_URL=http://localhost:3000
SLACK_BOT_TOKEN=
SLACK_NOTIFICATION_CHANNEL=

S3_BUCKET_NAME=parabellum-groups
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=replace-with-a-strong-minio-password

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=3
ENFORCE_PERMISSION_WORKFLOW=false
PRISMA_LOG_WARN=false
PRISMA_LOG_QUERIES=false
