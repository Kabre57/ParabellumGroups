# Copy to .env for local runs outside Docker Compose.
NODE_ENV=development
PORT=4005
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_inventory?schema=public
JWT_SECRET=replace-with-a-long-random-secret
AUTH_SERVICE_URL=http://localhost:4001

S3_BUCKET_NAME=parabellum-groups
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=replace-with-a-strong-minio-password
