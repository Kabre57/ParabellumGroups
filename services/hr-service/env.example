# Copy to .env for local runs outside Docker Compose.
NODE_ENV=development
PORT=4009
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_hr?schema=public
JWT_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:16379
HR_MATRICULE_PREFIX=EMP

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
