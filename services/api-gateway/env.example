# Copy to .env for local runs outside Docker Compose.
NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Standalone runs only: set each URL to a service you have started and made
# reachable from this host. The root Compose file does not publish these ports.
AUTH_SERVICE_URL=http://localhost:4001
COMMUNICATION_SERVICE_URL=http://localhost:4002
TECHNICAL_SERVICE_URL=http://localhost:4003
COMMERCIAL_SERVICE_URL=http://localhost:4004
INVENTORY_SERVICE_URL=http://localhost:4005
PROJECTS_SERVICE_URL=http://localhost:4006
PROCUREMENT_SERVICE_URL=http://localhost:4007
CUSTOMERS_SERVICE_URL=http://localhost:4008
# Separate RH/paie API base URL. Configure the real URL for your environment.
HR_SERVICE_URL=http://localhost:8001
BILLING_SERVICE_URL=http://localhost:4010
ANALYTICS_SERVICE_URL=http://localhost:4011
NOTIFICATIONS_SERVICE_URL=http://localhost:4012

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000
BILLING_READ_RATE_LIMIT_MAX=300
# Optional for development; required in production to share counters between replicas.
REDIS_URL=redis://:replace-with-redis-password@localhost:16379
LOG_LEVEL=info
