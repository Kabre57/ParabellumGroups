# Copy to .env for local runs outside Docker Compose.
NODE_ENV=development
PORT=4010
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_billing?schema=public
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:16379

PROJECTS_SERVICE_URL=http://localhost:4006
COMMERCIAL_SERVICE_URL=http://localhost:4004
CUSTOMERS_SERVICE_URL=http://localhost:4008
AUTH_SERVICE_URL=http://localhost:4001
COMMUNICATION_SERVICE_URL=http://localhost:4002
NOTIFICATION_SERVICE_URL=http://localhost:4012
PROCUREMENT_EVENT_SECRET=replace-with-the-same-secret-used-by-procurement-service
APP_PUBLIC_URL=http://localhost:3000

S3_BUCKET_NAME=parabellum-groups
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=replace-with-a-strong-minio-password
