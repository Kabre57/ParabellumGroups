# Copy to .env for local runs outside Docker Compose.
NODE_ENV=development
PORT=4007
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_procurement?schema=public
JWT_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:16379
AUTH_SERVICE_URL=http://localhost:4001
BILLING_EVENTS_URL=http://localhost:4010/api/internal/procurement-events
PROCUREMENT_EVENT_SECRET=replace-with-the-same-secret-used-by-billing-service
PROCUREMENT_OUTBOX_INTERVAL_MS=5000
PROCUREMENT_OUTBOX_RETRY_MS=15000
PROCUREMENT_OUTBOX_BATCH_SIZE=20
