# Copy to .env for local runs outside Docker Compose.
NODE_ENV=development
PORT=4003
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_technical?schema=public
# Optional aliases used by the database backfill script
TECHNICAL_DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_technical?schema=public
CUSTOMER_DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:15432/parabellum_customers?schema=public
JWT_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:16379
CUSTOMERS_SERVICE_URL=http://localhost:4008

# Local MinIO storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
MINIO_BUCKET=rapport-photos
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_INTERNAL_URL=http://localhost:9000
MINIO_USE_SSL=false

# Optional report generation settings
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
REPORT_LOGO_URL=http://localhost:3000/parabellum.jpg
