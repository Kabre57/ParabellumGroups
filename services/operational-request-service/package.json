{
  "name": "operational-request-service",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/**/*.test.js\" \"test/integration/**/*.test.ts\"",
    "test:integration": "node --test \"test/integration/**/*.test.ts\"",
    "typecheck:test": "tsc --noEmit --strict --skipLibCheck --target es2023 --module esnext --moduleResolution bundler --allowImportingTsExtensions --allowJs --esModuleInterop test/helpers/testPrisma.ts test/helpers/billingStub.ts test/integration/linkCashVoucher.test.ts test/integration/createCashVoucher.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1020.0",
    "@prisma/client": "5.14.0",
    "cors": "2.8.5",
    "express": "^4.22.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "prisma": "5.14.0"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "6.19.0",
    "@prisma/client-test": "npm:@prisma/client@6.19.0",
    "@prisma/internals": "6.19.0",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
