# API Gateway : conserver le suffixe /api.
# Simulateur iOS sur le Mac qui heberge l'API : http://localhost:4000/api
# Emulateur Android standard : http://10.0.2.2:4000/api
# Telephone physique : IP locale du PC, par exemple http://192.168.1.29:4000/api
# Le telephone et le PC doivent pouvoir communiquer sur le reseau local.
EXPO_PUBLIC_API_URL="http://localhost:4000/api"

# UUID du projet EAS pour obtenir un token push dans un Development Build.
# Facultatif pour les notifications locales dans Expo Go.
# Peut aussi etre fourni via expo.extra.eas.projectId dans app.json.
EXPO_PUBLIC_EAS_PROJECT_ID=""
