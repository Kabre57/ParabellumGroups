# Parabellum Groups - Generic environment template
# Prefer one of these:
#   cp .env.production.example .env   # VPS / production-like setup
#   cp .env.development.example .env  # local development setup

# JWT Secret (shared by auth-related services)
JWT_SECRET=replace-with-a-long-random-secret

# Base URL of the separate RH/paie API (accessible from Docker containers).
HR_SERVICE_URL=http://host.docker.internal:8001

# Database (PostgreSQL container + services)
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=parabellum

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password

# MinIO (S3 compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

# S3 local (MinIO)
S3_BUCKET_NAME=parabellum-groups
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=replace-with-a-strong-minio-password

# Optional email
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=admin@parabellum-erp.online

# Optional host port overrides
FRONTEND_HOST_IP=127.0.0.1
FRONTEND_HOST_PORT=3000
