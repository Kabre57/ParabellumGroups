# Parabellum Groups - Production environment template (VPS)
# Usage:
#   cp .env.production.example .env
#   edit every placeholder before running docker compose

NODE_ENV=production

# Core secrets
JWT_SECRET=replace-with-a-long-random-production-jwt-secret

# Public/private base URL of the separate RH/paie API, reachable from Docker.
HR_SERVICE_URL=https://rh-api.example.com

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=replace-with-a-very-strong-production-db-password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-very-strong-production-db-password
POSTGRES_DB=parabellum

# Redis
REDIS_PASSWORD=replace-with-a-very-strong-production-redis-password

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-very-strong-production-minio-password

# S3 compatible storage (replace endpoints and credentials for production)
S3_BUCKET_NAME=parabellum-groups
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=replace-with-a-very-strong-production-minio-password

# SMTP (configure before enabling email features)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=admin@parabellum-erp.online

# Optional frontend host port override
FRONTEND_HOST_IP=127.0.0.1
FRONTEND_HOST_PORT=3000
