# Parabellum Groups - Development environment template (local clone)
# Usage:
#   cp .env.development.example .env
#   docker compose up --build

NODE_ENV=development

# Core secrets
JWT_SECRET=replace-with-a-long-random-dev-jwt-secret

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-dev-db-password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-dev-db-password
POSTGRES_DB=parabellum

# Redis
REDIS_PASSWORD=replace-with-a-strong-dev-redis-password

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-dev-minio-password

# S3 local (MinIO)
S3_BUCKET_NAME=parabellum-groups
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=replace-with-a-strong-dev-minio-password

# Optional email (leave empty to disable SMTP locally)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=admin@parabellum-erp.online

# Optional host port overrides
FRONTEND_HOST_IP=127.0.0.1
FRONTEND_HOST_PORT=3000
BILLING_SERVICE_HOST_IP=0.0.0.0
BILLING_SERVICE_HOST_PORT=4010
